#!/usr/bin/env bash
# factory — the software factory's command line.
#   factory init        set up the current project: beads, AGENTS.md, CLAUDE.md, FACTORY.md
#   factory doctor      check the installation and the current project
#   factory update      pull the latest factory and relink
#   factory link        (re)link skills, agents and this command into ~/.claude and ~/.local/bin
#   factory uninstall   remove the links (beads and your projects are left alone)
set -euo pipefail

self="${BASH_SOURCE[0]}"; while [[ -L "$self" ]]; do self="$(readlink "$self")"; done
SRC="$(cd "$(dirname "$self")/.." && pwd)"
SKILLS="$HOME/.claude/skills"
AGENTS="$HOME/.claude/agents/factory"
BIN="$HOME/.local/bin"
BEGIN='<!-- BEGIN SOFTWARE FACTORY'
END='<!-- END SOFTWARE FACTORY -->'

say() { printf '%s\n' "$*"; }
ok()  { printf '  ok    %s\n' "$*"; }
bad() { printf '  FIX   %s\n' "$*"; PROBLEMS=$((PROBLEMS+1)); }

link_one() { # never replaces a real file or directory
  if [[ -e "$2" && ! -L "$2" ]]; then say "  skip  $2 (exists and is not a link)"; return; fi
  ln -sfn "$1" "$2"; say "  link  $2"
}

cmd_link() {
  mkdir -p "$SKILLS" "$(dirname "$AGENTS")" "$BIN"
  for d in "$SRC"/skills/*/; do link_one "${d%/}" "$SKILLS/$(basename "$d")"; done
  link_one "$SRC/agents" "$AGENTS"
  link_one "$SRC/bin/factory" "$BIN/factory"
  case ":$PATH:" in *":$BIN:"*) ;; *) say "  note  $BIN is not on your PATH; add it, or call $SRC/bin/factory directly";; esac
  cat <<'MSG'

Software factory installed.
  1. Restart Claude Code (new agent types register when a session starts).
  2. In a project:    factory init         beads + AGENTS.md + CLAUDE.md + FACTORY.md, instantly
  3. In Claude Code:  /factory-setup       fills them in from the code and proves the gate
  4. Then:            /factory <what you want built>
MSG
}

cmd_uninstall() {
  for d in "$SRC"/skills/*/; do l="$SKILLS/$(basename "$d")"; if [[ -L "$l" ]]; then rm "$l"; say "  removed $l"; fi; done
  for l in "$AGENTS" "$BIN/factory"; do if [[ -L "$l" ]]; then rm "$l"; say "  removed $l"; fi; done
  say "Links removed. The checkout at $SRC and beads are untouched."
}

cmd_update() {
  if [[ -d "$SRC/.git" ]]; then git -C "$SRC" pull --ff-only; else say "$SRC is not a git checkout; nothing to pull"; fi
  cmd_link
}

agents_block() { # the managed block, extracted from the template so there is one source of truth
  awk '/^<!-- BEGIN SOFTWARE FACTORY/{p=1} p{print} /^<!-- END SOFTWARE FACTORY -->/{exit}' \
    "$SRC/skills/factory/reference/agents-template.md"
}

cmd_init() {
  command -v bd >/dev/null 2>&1 || { say "bd (beads) is not installed. Run the factory installer first."; exit 1; }
  local name prefix
  name="$(basename "$PWD")"

  # git
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then say "  ok    git repository"
  else git init -q; say "  new   git repository"; fi

  # beads
  if [[ -d .beads ]]; then say "  ok    .beads/ (existing database kept)"
  else
    prefix="${1:-$(printf '%s' "$name" | tr -cd '[:alpha:]' | tr '[:upper:]' '[:lower:]' | cut -c1-3)}"
    bd init --non-interactive --prefix "${prefix:-fx}" >/dev/null 2>&1
    say "  new   .beads/ (issue prefix: ${prefix:-fx})"
  fi

  # FACTORY.md
  if [[ -f FACTORY.md ]]; then say "  ok    FACTORY.md (kept)"
  else cp "$SRC/skills/factory/reference/profile-template.md" FACTORY.md; say "  new   FACTORY.md (template; /factory-setup fills it in)"; fi

  # AGENTS.md
  [[ -f AGENTS.md ]] || printf '# Agent Instructions\n' > AGENTS.md
  if grep -qF "$BEGIN" AGENTS.md; then say "  ok    AGENTS.md (factory block present)"
  else { printf '\n'; agents_block; } >> AGENTS.md; say "  new   AGENTS.md factory block (how work gets done + system design)"; fi

  # CLAUDE.md imports AGENTS.md
  [[ -f CLAUDE.md ]] || printf '# Project instructions\n' > CLAUDE.md
  if grep -qxF '@AGENTS.md' CLAUDE.md; then say "  ok    CLAUDE.md imports AGENTS.md"
  else printf '\n@AGENTS.md\n' >> CLAUDE.md; say "  new   CLAUDE.md now imports AGENTS.md"; fi

  cat <<'MSG'

Project is wired for the factory. Nothing was committed.
Next, in Claude Code in this directory:
  /factory-setup      reads the code, proves the gate, fills in FACTORY.md and the system design
  /factory <request>  delivers work
MSG
}

cmd_doctor() {
  PROBLEMS=0
  say "Installation"
  if command -v bd >/dev/null 2>&1; then ok "beads: $(bd version 2>/dev/null | head -1)"; else bad "bd not found — run the installer"; fi
  [[ -L "$SKILLS/factory" ]] && ok "skills linked" || bad "skills not linked — run: factory link"
  [[ -L "$AGENTS" ]] && ok "agents linked" || bad "agents not linked — run: factory link"
  say "Project ($PWD)"
  [[ -d .beads ]] && ok ".beads/" || bad "no .beads/ — run: factory init"
  if [[ -f FACTORY.md ]]; then
    if grep -q '<One paragraph' FACTORY.md; then bad "FACTORY.md is still the template — run /factory-setup in Claude Code"; else ok "FACTORY.md"; fi
  else bad "no FACTORY.md — run: factory init"; fi
  if [[ -f AGENTS.md ]] && grep -qF "$BEGIN" AGENTS.md; then
    [[ "$(grep -cF "$BEGIN" AGENTS.md)" == 1 ]] && ok "AGENTS.md factory block" || bad "AGENTS.md has more than one factory block"
    if grep -q '<Two or three sentences' AGENTS.md; then bad "System design in AGENTS.md is still the template — run /factory-setup"; fi
  else bad "AGENTS.md has no factory block — run: factory init"; fi
  if [[ -f CLAUDE.md ]] && grep -qxF '@AGENTS.md' CLAUDE.md; then ok "CLAUDE.md imports AGENTS.md"; else bad "CLAUDE.md does not import AGENTS.md — run: factory init"; fi
  [[ $PROBLEMS == 0 ]] && say "All good." || { say "$PROBLEMS thing(s) to fix."; exit 1; }
}

case "${1:-}" in
  init) shift; cmd_init "$@";;
  doctor) cmd_doctor;;
  update) cmd_update;;
  link) cmd_link;;
  uninstall) cmd_uninstall;;
  *) sed -n '2,7p' "$self" | sed 's/^# \{0,1\}//';;
esac
