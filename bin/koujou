#!/usr/bin/env bash
# koujou — the software factory's command line.
#   koujou init        set up the current project: beads, AGENTS.md, CLAUDE.md, FACTORY.md
#   koujou doctor      check the installation and the current project
#   koujou accept <task-id>... | --parent <epic-id> | --label <label>   run tasks' acceptance tests
#   koujou accept --red <task-id> --base <ref>   prove the task's tests fail without its change
#   koujou times <epic-id> | --label <label>   where a run's time went, read from beads
#   koujou ready <epic-id> | --label <label>   tasks that can start now (landed tasks awaiting merge count as done)
#   koujou board start|stop|install|tui|add <path>   the live kanban (koujou-ui, a separate package)
#   koujou status [<epic-id> | --label <label>]   one screen: runs, budget, live agents past their box, asks, strays
#   koujou spawned <id>... [--role <role>] [--resumed]   count an agent run (--role tracks it live; --resumed: live again, not counted)
#   koujou reported <id> --role <role> | --all   that agent (or every agent on it) has reported; no longer live
#   koujou budget <epic-id> | --label <label>   is the run inside its budget of agents and time? (spawned checks it too)
#   koujou converge <epic-id> | --label <label> [--record]   may the fix loop go on? answered from the run's record
#   koujou wait <epic-id> start|end   time a run spends stopped, waiting on you
#   koujou awake start|stop|status   keep this machine from sleeping while a run lasts (macOS caffeinate, Linux systemd-inhibit)
#   koujou update      pull the latest factory and relink
#   koujou link        (re)link skills, agents and this command into ~/.claude and ~/.local/bin
#   koujou uninstall   remove the links (beads and your projects are left alone)
set -euo pipefail

self="${BASH_SOURCE[0]}"; while [[ -L "$self" ]]; do self="$(readlink "$self")"; done
SRC="$(cd "$(dirname "$self")/.." && pwd)"
SKILLS="$HOME/.claude/skills"
AGENTS="$HOME/.claude/agents/factory"
BIN="$HOME/.local/bin"
BEGIN='<!-- BEGIN SOFTWARE FACTORY'
END='<!-- END SOFTWARE FACTORY -->'

say() { printf '%s\n' "$*"; }
ok()  { printf '  ok    %s\n' "$*"; }
bad() { printf '  FIX   %s\n' "$*"; PROBLEMS=$((PROBLEMS+1)); }

link_one() { # never replaces a real file or directory
  if [[ -e "$2" && ! -L "$2" ]]; then say "  skip  $2 (exists and is not a link)"; return; fi
  ln -sfn "$1" "$2"; say "  link  $2"
}

cmd_link() {
  mkdir -p "$SKILLS" "$(dirname "$AGENTS")" "$BIN"
  for d in "$SRC"/skills/*/; do link_one "${d%/}" "$SKILLS/$(basename "$d")"; done
  link_one "$SRC/agents" "$AGENTS"
  link_one "$SRC/bin/koujou" "$BIN/koujou"
  if [[ -L "$BIN/factory" ]]; then rm "$BIN/factory"; fi   # name used before the rename
  case ":$PATH:" in *":$BIN:"*) ;; *) say "  note  $BIN is not on your PATH; add it, or call $SRC/bin/koujou directly";; esac
  cat <<'MSG'

Koujou (software factory) installed.
  1. Restart Claude Code (new agent types register when a session starts).
  2. In a project:    koujou init         beads + AGENTS.md + CLAUDE.md + FACTORY.md, instantly
  3. In Claude Code:  /factory-setup       fills them in from the code and proves the gate
  4. Then:            /factory <what you want built>
MSG
}

cmd_uninstall() {
  for d in "$SRC"/skills/*/; do l="$SKILLS/$(basename "$d")"; if [[ -L "$l" ]]; then rm "$l"; say "  removed $l"; fi; done
  for l in "$AGENTS" "$BIN/koujou"; do if [[ -L "$l" ]]; then rm "$l"; say "  removed $l"; fi; done
  say "Links removed. The checkout at $SRC and beads are untouched."
}

cmd_update() {
  if [[ -d "$SRC/.git" ]]; then git -C "$SRC" pull --ff-only; else say "$SRC is not a git checkout; nothing to pull"; fi
  cmd_link
}

agents_block() { # the managed block, extracted from the template so there is one source of truth
  awk '/^<!-- BEGIN SOFTWARE FACTORY/{p=1} p{print} /^<!-- END SOFTWARE FACTORY -->/{exit}' \
    "$SRC/skills/factory/reference/agents-template.md"
}

cmd_init() {
  command -v bd >/dev/null 2>&1 || { say "bd (beads) is not installed. Run the koujou installer first."; exit 1; }
  local name prefix
  name="$(basename "$PWD")"

  # git
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then say "  ok    git repository"
  else git init -q; say "  new   git repository"; fi

  # beads
  if [[ -d .beads ]]; then say "  ok    .beads/ (existing database kept)"
  else
    prefix="${1:-$(printf '%s' "$name" | tr -cd '[:alpha:]' | tr '[:upper:]' '[:lower:]' | cut -c1-3)}"
    bd init --non-interactive --prefix "${prefix:-fx}" >/dev/null 2>&1
    say "  new   .beads/ (issue prefix: ${prefix:-fx})"
  fi

  # FACTORY.md
  if [[ -f FACTORY.md ]]; then say "  ok    FACTORY.md (kept)"
  else cp "$SRC/skills/factory/reference/profile-template.md" FACTORY.md; say "  new   FACTORY.md (template; /factory-setup fills it in)"; fi

  # AGENTS.md
  [[ -f AGENTS.md ]] || printf '# Agent Instructions\n' > AGENTS.md
  if grep -qF "$BEGIN" AGENTS.md; then say "  ok    AGENTS.md (factory block present)"
  else { printf '\n'; agents_block; } >> AGENTS.md; say "  new   AGENTS.md factory block (how work gets done + system design)"; fi

  # CLAUDE.md imports AGENTS.md
  [[ -f CLAUDE.md ]] || printf '# Project instructions\n' > CLAUDE.md
  if grep -qxF '@AGENTS.md' CLAUDE.md; then say "  ok    CLAUDE.md imports AGENTS.md"
  else printf '\n@AGENTS.md\n' >> CLAUDE.md; say "  new   CLAUDE.md now imports AGENTS.md"; fi

  # put the project on the board (koujou-ui reads this list)
  mkdir -p "${KOUJOU_STATE:-$HOME/.koujou}"
  grep -qxF "$PWD" "${KOUJOU_STATE:-$HOME/.koujou}/projects" 2>/dev/null || printf '%s\n' "$PWD" >> "${KOUJOU_STATE:-$HOME/.koujou}/projects"

  cat <<'MSG'

Project is wired for the factory. The factory's files are not committed (beads commits its own on first setup).
Next, in Claude Code in this directory:
  /factory-setup      reads the code, proves the gate, fills in FACTORY.md and the system design
  /factory <request>  delivers work
MSG
}

cmd_times() { # where a run's time went, read from beads
  command -v bd >/dev/null 2>&1 || { say "bd (beads) is not installed."; exit 1; }
  command -v python3 >/dev/null 2>&1 || { say "koujou times needs python3."; exit 1; }
  python3 "$SRC/bin/koujou-times.py" "$@"
}

cmd_accept() { # run tasks' acceptance commands (beads metadata `accept`) in the current directory
  command -v bd >/dev/null 2>&1 || { say "bd (beads) is not installed."; exit 1; }
  command -v python3 >/dev/null 2>&1 || { say "koujou accept needs python3."; exit 1; }
  python3 "$SRC/bin/koujou-accept.py" "$@"
}

cmd_converge() { # may the validate-and-fix loop go on? (exit 1 = stop)
  command -v bd >/dev/null 2>&1 || { say "bd (beads) is not installed."; exit 1; }
  command -v python3 >/dev/null 2>&1 || { say "koujou converge needs python3."; exit 1; }
  python3 "$SRC/bin/koujou-converge.py" "$@"
}

cmd_ready() { # tasks of a run that can start now
  command -v bd >/dev/null 2>&1 || { say "bd (beads) is not installed."; exit 1; }
  command -v python3 >/dev/null 2>&1 || { say "koujou ready needs python3."; exit 1; }
  python3 "$SRC/bin/koujou-ready.py" "$@"
}

cmd_spawned() { # count an agent run
  command -v bd >/dev/null 2>&1 || { say "bd (beads) is not installed."; exit 1; }
  command -v python3 >/dev/null 2>&1 || { say "koujou spawned needs python3."; exit 1; }
  python3 "$SRC/bin/koujou-spawned.py" "$@"
}

cmd_budget() { # is the run inside its budget of agents and time? (exit 1 = over)
  command -v bd >/dev/null 2>&1 || { say "bd (beads) is not installed."; exit 1; }
  command -v python3 >/dev/null 2>&1 || { say "koujou budget needs python3."; exit 1; }
  python3 "$SRC/bin/koujou-budget.py" "$@"
}

cmd_board() { # the live kanban lives in its own package: koujou-ui
  local ui=""
  if command -v koujou-ui >/dev/null 2>&1; then ui="koujou-ui"
  elif [[ -f "$SRC/../koujou-ui/server/cli.js" ]]; then ui="node $SRC/../koujou-ui/server/cli.js"; fi
  if [[ -z "$ui" ]]; then
    say "The board is koujou-ui, a separate package. Install it once:"
    say "  git clone https://github.com/rummykhan/koujou-ui && cd koujou-ui && npm install -g ."
    say "then: koujou board start   (or: koujou board install, to keep it always running)"
    return 1
  fi
  $ui "$@"
}

cmd_status() { # one screen: runs, budget, live agents, asks, strays
  command -v bd >/dev/null 2>&1 || { say "bd (beads) is not installed."; exit 1; }
  python3 "$SRC/bin/koujou-status.py" "$@"
  printf 'machine: '; cmd_awake status
}

cmd_wait() { # time a run spends stopped, waiting on the user
  command -v bd >/dev/null 2>&1 || { say "bd (beads) is not installed."; exit 1; }
  command -v python3 >/dev/null 2>&1 || { say "koujou wait needs python3."; exit 1; }
  python3 "$SRC/bin/koujou-wait.py" "$@"
}

cmd_awake() { # keep the machine awake for a long run; sleep stalls agents and makes timed waits fail
  local dir="${KOUJOU_STATE:-$HOME/.koujou}" pidf hours="${KOUJOU_AWAKE_HOURS:-12}"
  mkdir -p "$dir"; pidf="$dir/awake.pid"
  local running=""; [[ -f "$pidf" ]] && kill -0 "$(cat "$pidf")" 2>/dev/null && running=$(cat "$pidf")
  case "${1:-status}" in
    start)
      if [[ -n "$running" ]]; then say "already keeping this machine awake (pid $running)"; return 0; fi
      if command -v caffeinate >/dev/null 2>&1; then
        nohup caffeinate -dimsu -t $((hours * 3600)) >/dev/null 2>&1 & echo $! > "$pidf"
        say "keeping this machine awake for up to ${hours}h (caffeinate, pid $(cat "$pidf")); stop with: koujou awake stop"
        if command -v pmset >/dev/null 2>&1 && pmset -g batt 2>/dev/null | grep -q "Battery Power"; then
          say "on battery: closing the lid will still sleep the machine. Plug in, or keep the lid open, until the run ends."
        fi
      elif command -v systemd-inhibit >/dev/null 2>&1; then
        nohup systemd-inhibit --what=sleep:idle --who=koujou --why="factory run" sleep $((hours * 3600)) >/dev/null 2>&1 & echo $! > "$pidf"
        say "keeping this machine awake for up to ${hours}h (systemd-inhibit, pid $(cat "$pidf")); stop with: koujou awake stop"
      else
        say "no caffeinate or systemd-inhibit here; keep the machine awake yourself while the run lasts"; return 1
      fi;;
    stop)
      if [[ -n "$running" ]]; then kill "$running" 2>/dev/null || true; say "stopped keeping this machine awake"; else say "not keeping this machine awake"; fi
      rm -f "$pidf";;
    status) if [[ -n "$running" ]]; then say "awake (pid $running)"; else say "not keeping this machine awake"; fi;;
    *) say "usage: koujou awake start|stop|status"; return 2;;
  esac
}

cmd_doctor() {
  PROBLEMS=0
  say "Installation"
  if command -v bd >/dev/null 2>&1; then ok "beads: $(bd version 2>/dev/null | head -1)"; else bad "bd not found — run the installer"; fi
  [[ -L "$SKILLS/factory" ]] && ok "skills linked" || bad "skills not linked — run: koujou link"
  [[ -L "$AGENTS" ]] && ok "agents linked" || bad "agents not linked — run: koujou link"
  say "Project ($PWD)"
  [[ -d .beads ]] && ok ".beads/" || bad "no .beads/ — run: koujou init"
  if [[ -f FACTORY.md ]]; then
    if grep -q '<One paragraph' FACTORY.md; then bad "FACTORY.md is still the template — run /factory-setup in Claude Code"
    else
      # a profile written by an older factory lacks what newer stages read; say exactly what
      local missing=""
      grep -q '^## QA' FACTORY.md || missing="$missing, a QA section (how to run one task's tests)"
      grep -q '^## Test map' FACTORY.md || missing="$missing, a Test map section (how each module is tested and cross-checked)"
      grep -q '^## Security review' FACTORY.md || missing="$missing, a Security review section"
      grep -q '^- Merge:' FACTORY.md || missing="$missing, a 'Merge:' line in Git policy (who merges the pull request)"
      grep -q 'max_rebases' FACTORY.md || missing="$missing, max_rebases in Limits"
      if [[ -n "$missing" ]]; then bad "FACTORY.md predates this version of the factory. Missing:${missing#,}. Run /factory-setup to refresh it"; else ok "FACTORY.md"; fi
    fi
  else bad "no FACTORY.md — run: koujou init"; fi
  if [[ -f AGENTS.md ]] && grep -qF "$BEGIN" AGENTS.md; then
    [[ "$(grep -cF "$BEGIN" AGENTS.md)" == 1 ]] && ok "AGENTS.md factory block" || bad "AGENTS.md has more than one factory block"
    if grep -q '<Two or three sentences' AGENTS.md; then bad "System design in AGENTS.md is still the template — run /factory-setup"; fi
  else bad "AGENTS.md has no factory block — run: koujou init"; fi
  if [[ -f CLAUDE.md ]] && grep -qxF '@AGENTS.md' CLAUDE.md; then ok "CLAUDE.md imports AGENTS.md"; else bad "CLAUDE.md does not import AGENTS.md — run: koujou init"; fi
  [[ $PROBLEMS == 0 ]] && say "All good." || { say "$PROBLEMS thing(s) to fix."; exit 1; }
}

case "${1:-}" in
  init) shift; cmd_init "$@";;
  doctor) cmd_doctor;;
  times) shift; cmd_times "$@";;
  accept) shift; cmd_accept "$@";;
  wait) shift; cmd_wait "$@";;
  awake) shift; cmd_awake "$@";;
  ready) shift; cmd_ready "$@";;
  spawned) shift; cmd_spawned "$@";;
  reported) shift; cmd_spawned --reported "$@";;
  status) shift; cmd_status "$@";;
  board) shift; cmd_board "$@";;
  converge) shift; cmd_converge "$@";;
  budget) shift; cmd_budget "$@";;
  update) cmd_update;;
  link) cmd_link;;
  uninstall) cmd_uninstall;;
  *) sed -n '2,19p' "$self" | sed 's/^# \{0,1\}//';;
esac
